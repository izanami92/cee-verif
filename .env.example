# Configuration de l'application CEE Vérif
# Copier ce fichier en .env pour le développement local
# En production, configurer ces variables dans Vercel Dashboard > Settings > Environment Variables

# Clé API OpenRouter (donne accès à Claude et autres modèles)
# Obtenir sur : https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Mot de passe unique pour accéder à l'application
# Partagé entre tous les collaborateurs
APP_PASSWORD=VotreMotDePasseSecurise2026
